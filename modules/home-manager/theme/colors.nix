palette: {
  inherit (palette) background0;
  inherit (palette) background1;

  inherit (palette) foreground0;
  inherit (palette) foreground1;
  inherit (palette) foreground2;

  inherit (palette) accentPrimary0;
  inherit (palette) accentPrimary1;

  inherit (palette) accentSecondary0;
  inherit (palette) accentSecondary1;

  success = palette.green;
  warning = palette.yellow;
  danger = palette.red;

  black = "#000000";
  white = "#ffffff";
}
